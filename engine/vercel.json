{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,benchmarks/**,data/{50k_stress,reconriver,real,demo_*,batch_close,history,_archive,public_ledgers}/**,data/*.json,data/*.sqlite3*,**/__pycache__/**,**/*.pyc,**/pandas/tests/**,**/numpy/**/tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
