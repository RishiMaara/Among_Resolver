# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root. These come from the Python packaging block
# below, and an unanchored "lib/" matches src/lib/ at any depth — which
# silently untracked the frontend's api.ts and agent-flow.ts. Those two are
# imported by all three routes, so a fresh clone of this repository did not
# build. Nothing said so: the files were on disk, the app ran locally, and
# `git status` was clean because git had been told to ignore them.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?

# Local PR scratch — description of an already-merged PR, not project source
PR_BODY.md

# Run history: reconciliation output per run, useful locally but not
# source. Regenerated by any run; committing them would bloat the repo.
engine/data/history/

# Fetched sanctions lists. Derived data and a point-in-time snapshot: a copy
# committed here is stale a week later, and stale screening is the failure
# that matters. Run engine/scripts/fetch_sanctions_list.py.
engine/data/sanctions/
data/sanctions/

# Build and tooling caches that were reaching git only because nothing
# named them. .tanstack and .lovable are editor/router scratch; the Python
# ones accumulate on every test run.
.tanstack/
.lovable/
__pycache__/
*.py[cod]
.pytest_cache/

# The durable audit store. Runtime data, written by every reconciliation —
# and it holds settlement details, so it must never reach a public repo.
engine/data/audit.sqlite3*

# Source is never ignored, whatever a template above may match. This exists
# because an unanchored "lib/" from the Python block silently untracked
# src/lib/api.ts and src/lib/agent-flow.ts — imported by all three routes —
# so the repository did not build from a fresh clone while `git status` stayed
# clean.
!src/**
!engine/src/**
!engine/tests/**

# ...but build artefacts still are. These rules come after the negations
# above, and in gitignore the last matching rule wins.
__pycache__/
*.py[cod]
*.so

# Archived audit databases. The rule above only covers engine/data/audit.sqlite3*
# directly — the moment you follow PITCH_DEMO_PACK.md and move the database into
# _archive/ between demo takes, it lands OUTSIDE that rule. It is ~400 MB and it
# holds settlement details, so `git add -A` would both blow past GitHub's file
# limit and stage merchant data into a public repository.
engine/data/_archive/

# Scratch directories from local tooling runs (TEMP redirected off C:).
.tmp-*/

engine/data/batch_close/
